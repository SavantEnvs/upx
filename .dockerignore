# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# build/            local dev cmake build (top-level Makefile's build/{debug,release})
# build-fuzz/ build-test/   mayhem/build.sh's own output trees (built INSIDE the image; keeping
#                            them out of the CI build CONTEXT just avoids shipping stale host-built
#                            objects if a developer ran build.sh locally before docker build).
build/
build-fuzz/
build-test/
out/
*.o
*.a
*.so
*.dylib
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
